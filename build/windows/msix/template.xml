<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="mauvelauncher"
        Arguments=""
        InstallLocation="C:\Program Files\Mauve Launcher">
    </Installer>
    <PackageInformation
        PackageName="Mauve Launcher"
        PackageDisplayName="Mauve Launcher"
        PublisherName="CN=pencil stub
        PublisherDisplayName="pencil stub"
        Version="0.1.0.0"
        PackageDescription="An open-source Minecraft launcher focused on customizability and resource efficiency">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.pencilstub.mauvelauncher"
                Description="An open-source Minecraft launcher focused on customizability and resource efficiency"
                DisplayName="Mauve Launcher"
                ExecutableName="mauvelauncher"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Mauve Launcher</DisplayName>
            <PublisherDisplayName>pencil stub</PublisherDisplayName>
            <Description>An open-source Minecraft launcher focused on customizability and resource efficiency</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="mauvelauncher.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
